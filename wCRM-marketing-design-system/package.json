{
  "name": "wcrm-marketing-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Wragby wCRM Marketing design system: tokens, React components and Storybook documentation extracted from the Figma 'marketing design updates' page.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/styles",
    "tokens",
    "tailwind.preset.js"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build": "npm run tokens && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "foundations:html": "tsx scripts/render-foundations.tsx"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "clsx": "2.1.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "8.6.19",
    "@storybook/addon-essentials": "8.6.19",
    "@storybook/blocks": "8.6.19",
    "@storybook/manager-api": "8.6.19",
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "8.6.19",
    "@storybook/test": "8.6.19",
    "@storybook/theming": "8.6.19",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "storybook": "8.6.19",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind.preset.js": "./tailwind.preset.js",
    "./styles.css": "./src/styles/index.css",
    "./tokens.json": "./tokens/tokens.json"
  }
}

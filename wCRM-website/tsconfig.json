{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ds": ["../wCRM-marketing-design-system/src/index.ts"],
      "@ds/*": ["../wCRM-marketing-design-system/src/*"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src", "../wCRM-marketing-design-system/src/assets.d.ts"]
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "HOOK_EVENT=SessionStart \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-sync-pull.sh", "timeout": 60, "statusMessage": "Pulling updates from GitHub..." }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "HOOK_EVENT=UserPromptSubmit \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-sync-pull.sh", "timeout": 60, "statusMessage": "Checking GitHub for updates..." }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git-sync-push.sh", "timeout": 120, "statusMessage": "Pushing changes to GitHub..." }
        ]
      }
    ]
  }
}
